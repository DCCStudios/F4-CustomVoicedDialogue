<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CustomVoicedDialogue.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CustomVoicedDialogue.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- CMU Pronouncing Dictionary (BSD-licensed, see Resources/cmudict-LICENSE.txt):
         the General American base pronunciations the accent rules transform. -->
    <EmbeddedResource Include="Resources\cmudict.dict.gz" />
  </ItemGroup>

</Project>
